#!/usr/bin/env python3
"""Refuse code that hand-rolls what pf-core already provides.

A written rule describes; this enforces. `CLAUDE.md` has said "never reach for a
third-party library when pf-core already provides it" since the first commit, and the
things below still got written — the atomic-write dance twice by hand, builtin `raise`s
in library code, the project's own error hierarchy bypassed for the base class it
derives from. None of that is carelessness. It is what happens when a framework's
surface is larger than any one session's memory of it.

So every rule names its replacement in the message. Reading the failure is meant to be
the whole of learning the fix.

Two things keep this honest. Strings and comments are blanked before the regex rules
run, because a gate that fires on prose gets `--no-verify`'d and then protects nothing.
And an exemption is per file with a reason, never a blanket skip.

Add a rule when a review finds the same hand-roll twice — not the first time.

    bin/check-framework            # the whole package
    bin/check-framework a.py b.py  # just these
"""
from __future__ import annotations

import ast
import io
import re
import sys
import tokenize
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "src" / "deckwright"

# Modules pf-core replaces outright. {import: (what to use instead, what it buys)}
BANNED_IMPORTS = {
    "logging": ("pf_core.log.get_logger(__name__)",
                "structured events, and the project's log level and file wiring"),
    "dotenv": ("pf_core.config.load_env",
               "entry points already load .env; a second loader fights the first"),
    "requests": ("pf_core.clients", "timeouts, retries and usage tracking"),
    "httpx": ("pf_core.clients", "timeouts, retries and usage tracking"),
    "concurrent.futures": ("pf_core.parallel.run_parallel",
                           "a reporter, resilient failure collection, one cap on width"),
    "multiprocessing": ("pf_core.parallel.run_parallel", "the same, without the process cost"),
}

# Builtins that must not be raised from library code. {name: (what to raise, why)}
BANNED_RAISES = {
    "Exception": ("a class from deckwright.errors", "an unsearchable log key and no context"),
    "RuntimeError": ("pf_core.exceptions.PreconditionError", "'required state not met'"),
    "ValueError": ("pf_core.exceptions.InvalidInputError", "'the caller passed something bad'"),
}

# (name, pattern, what to use, why). `name` is what an exemption refers to.
BANNED_CALLS = [
    ("env-read", re.compile(r"\bos\.(environ|getenv)\b"),
     "pf_core.utils.env.resolve_int/resolve_str/resolve_bool",
     "malformed values warn and fall back instead of crashing"),
    ("print", re.compile(r"(?<![\w.])print\s*\("),
     "pf_core.log.get_logger(__name__), or typer.echo at the CLI boundary",
     "print() in a service is output nobody can level, filter or redirect"),
    ("logger-exception", re.compile(r"\blogger\.exception\s*\("), "pf_core.log.log_exception",
     "it carries the structured context and the project's event prefix"),
    ("atomic-write", re.compile(r"\bos\.replace\s*\("),
     "pf_core.utils.io.atomic_write_text / _json / _bytes",
     "the temp-file-then-rename dance is already written and tested"),
]

# {(rule, path relative to SRC): why it does not apply}. Every entry is a claim someone
# can check — and the path is the whole path, because two files can share a basename and
# an exemption written for one of them must not cover the other.
EXEMPT = {
    ("print", "cli.py"): "the CLI entry point is where user-facing output belongs",
    ("atomic-write", "panels/cache.py"):
        "an external renderer writes the cache's bytes; we never hold them, so there "
        "is nothing in hand for an atomic write to write",
}


def code_only(text: str) -> dict[int, str]:
    """Each line with its comments and string literals blanked out.

    Prose is where a framework name is *described* rather than used — a docstring saying
    "reads ``os.environ`` at call time" is documentation of the rule, not a breach of it.
    """
    lines = {n: line for n, line in enumerate(text.splitlines(), start=1)}
    try:
        tokens = list(tokenize.generate_tokens(io.StringIO(text).readline))
    except (tokenize.TokenError, IndentationError):
        return lines
    for token in tokens:
        if token.type not in (tokenize.STRING, tokenize.COMMENT):
            continue
        (r1, c1), (r2, c2) = token.start, token.end
        for row in range(r1, r2 + 1):
            line = lines.get(row, "")
            start = c1 if row == r1 else 0
            end = c2 if row == r2 else len(line)
            lines[row] = line[:start] + " " * (end - start) + line[end:]
    return lines


def check(path: Path) -> list[str]:
    """Every framework rule this file breaks, each naming its replacement."""
    text = path.read_text(encoding="utf-8")
    rel = path.relative_to(ROOT) if ROOT in path.parents else path
    found: list[str] = []

    for node in ast.walk(ast.parse(text)):
        seen: list[tuple[str, int]] = []
        if isinstance(node, ast.Import):
            seen = [(a.name, node.lineno) for a in node.names]
        elif isinstance(node, ast.ImportFrom) and node.module:
            seen = [(node.module, node.lineno)]
        for name, line in seen:
            hit = BANNED_IMPORTS.get(name) or BANNED_IMPORTS.get(name.split(".")[0])
            if hit:
                found.append(f"{rel}:{line}: imports {name!r} — use {hit[0]} ({hit[1]})")

        if isinstance(node, ast.Raise) and node.exc is not None:
            call = node.exc.func if isinstance(node.exc, ast.Call) else node.exc
            raised = getattr(call, "id", None)
            if raised in BANNED_RAISES:
                use, why = BANNED_RAISES[raised]
                found.append(f"{rel}:{node.lineno}: raises {raised} — use {use} ({why})")

    for rule, pattern, use, why in BANNED_CALLS:
        key = str(path.relative_to(SRC)) if SRC in path.parents else path.name
        if (rule, key) in EXEMPT:
            continue
        for line_no, line in code_only(text).items():
            if pattern.search(line):
                found.append(f"{rel}:{line_no}: {line.strip()[:56]} — use {use} ({why})")
    return found


def main(argv: list[str]) -> int:
    given = [Path(a).resolve() for a in argv]
    paths = [p for p in given if p.suffix == ".py"] or sorted(SRC.rglob("*.py"))
    bad = [problem for p in paths if p.is_file() for problem in check(p)]
    if bad:
        print("Framework rules — pf-core already provides these:\n")
        for line in bad:
            print(f"  {line}")
        print(f"\n{len(bad)} to fix. The module index is docs/pf-core/modules.md.")
        print("If pf-core genuinely does not cover a case, add an EXEMPT entry here with")
        print("the reason — never a blanket skip.")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
