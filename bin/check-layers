#!/usr/bin/env python3
"""Enforce import-layering direction for deckwright (a src/ library).

pf-core's structural gate checks layering only for app/<layer>/ trees, so it is
a no-op on src/ libraries (pf-core included). This is the equivalent gate for
deckwright: a module may import its own layer or below, never upward.

    cli                                          L6  (entry point)
    conform                                      L5  (drives the compiler)
    compile, qa                                  L4  (build a deck / judge one)
    charts, components, icons, imagery,          L3  (the render core)
      layouts, panels, spec, theme
    motion, services, utils                      L2  (leaves with no deckwright deps
                                                      beyond errors)
    config, errors, paths, pkg root              L1  (no imports at all)

The eight L3 packages are ONE strongly connected component, not eight tiers:
layouts<->spec, layouts<->theme, layouts<->imagery and charts->layouts->spec->
components->charts are all real cycles, broken at runtime by function-local and
TYPE_CHECKING imports. Ranking them apart would only be possible by ignoring
those, which is exactly where an inversion would hide. Split the tier when the
cycles are gone, not before.

Every top-level module must appear in RANK, and rank() has no silent default:
an unlisted key drops its whole tier from the check without a word.

Wired into pre-commit and CI beside the pf-core structural gate. Exit 1 on any
upward import.
"""
from __future__ import annotations

import ast
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "src" / "deckwright"
RANK = {
    "cli": 6,
    # Attestation reads across the whole stack — glyphs, themes, the sample, the
    # tool resolvers — so it sits below the entry point and above everything it asks.
    "doctor": 5.5,
    "conform": 5,
    "compile": 4, "qa": 4,
    "charts": 3, "components": 3, "icons": 3, "imagery": 3,
    "layouts": 3, "panels": 3, "spec": 3, "theme": 3,
    "motion": 2, "services": 2, "utils": 2,
    "config": 1, "errors": 1, "paths": 1,
}

# The package facade re-exports from every tier below it, so it sits above all of
# them — including `cli`. Ranking it here also makes the converse an error: nothing
# inside the package may `import deckwright` and reach back through its own front door.
FACADE = 7


def rank(module: str) -> int | None:
    """Layer rank of a deckwright module path; None for anything external or unranked."""
    parts = module.split(".")
    if not parts or parts[0] != "deckwright":
        return None
    return RANK.get(parts[1]) if len(parts) > 1 else FACADE


def unranked() -> list[str]:
    """Top-level modules on disk that RANK does not name."""
    names = ({p.name for p in SRC.iterdir() if p.is_dir() and p.name != "__pycache__"}
             | {p.stem for p in SRC.glob("*.py") if p.stem != "__init__"})
    return sorted(names - set(RANK))


def main() -> int:
    bad: list[str] = []
    for path in sorted(SRC.rglob("*.py")):
        mod = ".".join(["deckwright", *path.relative_to(SRC).with_suffix("").parts]).removesuffix(".__init__")
        own = rank(mod)
        for node in ast.walk(ast.parse(path.read_text(encoding="utf-8"))):
            if isinstance(node, ast.Import):
                names = [a.name for a in node.names]
            elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
                names = [node.module]
            else:
                continue
            for name in names:
                r = rank(name)
                if r is not None and own is not None and r > own:
                    rel = path.relative_to(ROOT).as_posix()
                    bad.append(f"{rel}:{node.lineno}: {mod} (L{own}) imports {name} (L{r}) — upward import")
    missing = unranked()
    if missing:
        print("unranked top-level modules (add them to RANK in bin/check-layers):\n  "
              + "\n  ".join(missing))
    if bad:
        print("import-layering violations:\n  " + "\n  ".join(bad))
    if bad or missing:
        return 1
    print("import-layering OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
