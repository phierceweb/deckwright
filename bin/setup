#!/usr/bin/env bash
# Bootstrap deckwright: venv (Python 3.12+), editable install, .env, rule symlinks.
# Self-contained — works whether pf-core is pip-installed or a sibling checkout.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
ok()   { echo "  ✓ $*"; }
info() { echo "  $*"; }

pick_python() {
  local p
  for p in python3.13 python3.12 python3; do
    p="$(command -v "$p" 2>/dev/null || true)"
    [[ -n "$p" ]] || continue
    if "$p" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then
      echo "$p"; return 0
    fi
  done
  echo "No Python 3.12+ found. Install 3.12+ (e.g. brew install python@3.12)." >&2
  exit 1
}

if [[ ! -d .venv ]]; then
  PY="$(pick_python)"
  info "Creating .venv ($("$PY" --version | tr -d '\r'))"
  "$PY" -m venv .venv
  ok ".venv created"
else
  ok ".venv exists ($(.venv/bin/python --version | tr -d '\r'))"
fi

info "Installing (editable, with dev extras) — pf-core resolves from PyPI..."
.venv/bin/python -m pip install --quiet --upgrade pip
GIT_TERMINAL_PROMPT=0 .venv/bin/python -m pip install -e ".[dev]"
ok "dependencies installed"

if [[ -f .env.example && ! -f .env ]]; then
  cp .env.example .env
  ok "copied .env.example -> .env"
fi

# Wire AI-assistant rule dirs to .ai/ (Claude Code / Cursor read these).
for tool in .claude .cursor; do
  mkdir -p "$tool"
  for d in rules skills; do
    [[ -e "$ROOT/.ai/$d" ]] || continue
    rm -rf "${tool:?}/$d"
    ln -s "../.ai/$d" "$tool/$d"
    ok "$tool/$d -> ../.ai/$d"
  done
done

# Link pf-core's module docs where assistants look. Re-resolves every run, so
# venv rebuilds and editable-vs-wheel installs both stay correct.
PF_DOCS="$(.venv/bin/python -c 'import pf_core, pathlib; print(pathlib.Path(pf_core.__file__).parent / "docs")' 2>/dev/null || true)"
if [[ -n "$PF_DOCS" && -d "$PF_DOCS" ]]; then
  mkdir -p docs
  ln -sfn "$PF_DOCS" docs/pf-core
  ok "docs/pf-core -> $PF_DOCS"
fi

# Ensure the structural-gate config exists (stamped by the scaffold; self-heals).
if [[ ! -f .pf-guards.toml ]]; then
  printf '[tool.pf_guards]\nroot = "src/deckwright"\n' > .pf-guards.toml
  ok "created .pf-guards.toml"
fi

# Install the commit gates (structural gate + ruff) when this is a git repo.
if [[ -d .git && -x .venv/bin/pre-commit ]]; then
  .venv/bin/pre-commit install >/dev/null
  ok "pre-commit hooks installed (gate runs on every commit)"
else
  info "not a git repo yet — run 'git init && .venv/bin/pre-commit install' to enable the commit gates"
fi

# --- generate ---------------------------------------------------------------
# The glyph bundle is committed, so this only confirms it arrived intact; it is a
# hash check over an archive, not a fetch. `deckwright glyphs sync` rebuilds it.
if .venv/bin/deckwright glyphs verify >/dev/null 2>&1; then
  ok "glyph bundle verified"
else
  info "glyph bundle missing or stale — rebuilding (needs a network)"
  .venv/bin/deckwright glyphs sync
fi

# A template to run `conform` against, so onboarding needs no brand file. Never
# overwritten: you may have put your own there, and doctor reports drift instead.
if [[ ! -f templates/sample.pptx ]]; then
  .venv/bin/deckwright sample >/dev/null
  ok "templates/sample.pptx written (try: bin/run conform templates/sample.pptx --adopt sample)"
else
  ok "templates/sample.pptx exists"
fi

# --- verify -----------------------------------------------------------------
# One real compile, end to end, into a temp dir: parse -> theme -> layout -> .pptx
# -> manifest. Needs no external tool, so it is the honest proof setup can give.
SMOKE="$(mktemp -d)"
if .venv/bin/deckwright build examples/smoke.deck.yaml --out "$SMOKE/Smoke.pptx" >/dev/null 2>&1 \
   && [[ -f "$SMOKE/Smoke.pptx" && -f "$SMOKE/Smoke.manifest.json" ]]; then
  ok "end-to-end build (examples/smoke.deck.yaml)"
else
  echo "FAILED: the smoke deck did not build — run it directly to see why:" >&2
  echo "  .venv/bin/deckwright build examples/smoke.deck.yaml --out /tmp/Smoke.pptx" >&2
  rm -rf "$SMOKE"
  exit 1
fi
rm -rf "$SMOKE"

echo
.venv/bin/deckwright doctor || true

echo
echo "Setup complete. Try: bin/run demo"
